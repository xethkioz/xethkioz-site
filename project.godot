[application]
config/name="World of Xethkioz · PLAYER ONLY TEST"
run/main_scene="res://scenes/test/PlayerOnlyMapTest.tscn"
config/features=PackedStringArray("4.7")

[autoload]
EventBus="*res://src/core/event_bus.gd"
GameState="*res://src/core/game_state.gd"
CharacterProfile="*res://src/core/character_profile.gd"

[debug]
gdscript/warnings/inference_on_variant=1

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.027, 0.035, 0.045, 1)
