[application]
config/name="World of Xethkioz"
run/main_scene="res://scenes/v34/GameBootstrap.tscn"
config/features=PackedStringArray("4.7")

[autoload]
EventBus="*res://src/core/event_bus.gd"
GameState="*res://src/core/game_state.gd"
CharacterProfile="*res://src/core/character_profile.gd"
InventoryService="*res://src/items/inventory_service.gd"
SaveService="*res://src/core/save_service.gd"
DemoEncounterDirector="*res://src/world/demo_encounter_director.gd"
BestiaryOverlay="*res://src/ui/bestiary_overlay.gd"

[debug]
gdscript/warnings/inference_on_variant=1

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.035, 0.045, 1)
