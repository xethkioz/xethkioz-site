{
  "buildCommand": "npm --prefix renacer-demo install && npm --prefix renacer-demo run build",
  "outputDirectory": "renacer-demo/dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
